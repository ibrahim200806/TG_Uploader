# =====================================
# Telegram API credentials (required)
# Get these from https://my.telegram.org
# =====================================
API_ID=12345678
API_HASH=abcd1234efgh5678ijkl9012mnop3456

# =====================================
# Bot credentials (required)
# Create a bot via @BotFather and paste token below
# =====================================
BOT_TOKEN=1234567890:ABCDEF1234567890abcdef1234567890

# =====================================
# Optional: user session fallback
# - If you want to allow fallback via user session
#   (for example, if the bot can’t message the owner)
# - You can use EITHER a phone number OR a session string.
#   The session string is preferred.
# =====================================

# Your phone number (used if you don’t provide USER_SESSION_STRING)
# Format: +15551234567
PHONE_NUMBER=

# If you have a saved Pyrogram session string for your user account,
# paste it here. This lets the script send via your personal account.
# NOTE: This should only ever be YOUR OWN account (never someone else's).
USER_SESSION_STRING=

# =====================================
# Optional proxy configuration
# If you use a SOCKS5 proxy, uncomment and set values.
# =====================================
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
